# Database (Local Postgres uses port 5433; Production uses Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stream_optimizer_dev

# Email Configuration
# Options: 'mailpit' (default for local dev) or 'resend' (for production)
EMAIL_PROVIDER=mailpit
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Production Email (Resend)
RESEND_API_KEY=

# Application Secret for Cron / Worker API
CRON_SECRET=dev_local_secret_key_123
